# TASK-00000005 environment template
# Fill values before running local development.

# Runtime
# Runtime mode (development/staging/production)
NODE_ENV=development
# Service timezone used by logs and schedules
TZ=Asia/Seoul

# Web
# Local port for Next.js web server
WEB_PORT=3000
# Public app name displayed in web UI
NEXT_PUBLIC_APP_NAME=AccountBook
# Public API base URL used by browser requests
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# API
# Local port for NestJS API server
API_PORT=4000
# Base path prefix for API routing
API_PREFIX=/api/v1
# JWT signing secret for authentication tokens
JWT_SECRET=CHANGE_ME
# JWT expiration period (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Database (PostgreSQL 16)
# PostgreSQL host address
POSTGRES_HOST=localhost
# PostgreSQL TCP port
POSTGRES_PORT=5432
# PostgreSQL database name
POSTGRES_DB=accountbook
# PostgreSQL user account
POSTGRES_USER=accountbook
# PostgreSQL password for POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME
# Full connection string used by ORM/app
DATABASE_URL=postgresql://accountbook:CHANGE_ME@localhost:5432/accountbook

# Cache/Queue (Redis 7)
# Redis host address
REDIS_HOST=localhost
# Redis TCP port
REDIS_PORT=6379
# Redis password (leave empty if disabled)
REDIS_PASSWORD=
# Full Redis connection URL
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO dev / S3 prod)
# S3-compatible endpoint URL
S3_ENDPOINT=http://localhost:9000
# Region for S3 or S3-compatible storage
S3_REGION=ap-northeast-2
# Bucket name for receipts/backups
S3_BUCKET=accountbook-local
# Access key for object storage
S3_ACCESS_KEY=minioadmin
# Secret key for object storage
S3_SECRET_KEY=minioadmin

# Observability
# Sentry DSN for error tracking
SENTRY_DSN=
# OTLP endpoint for traces/metrics export
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Prometheus service port
PROMETHEUS_PORT=9090
# Grafana service port
GRAFANA_PORT=3001

# Proxy (Nginx)
# Public HTTP port served by Nginx
NGINX_HTTP_PORT=80
# Public HTTPS port served by Nginx
NGINX_HTTPS_PORT=443

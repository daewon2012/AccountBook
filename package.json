{
  "name": "accountbook",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:web": "pnpm --filter @accountbook/web dev",
    "dev:mobile": "pnpm --filter @accountbook/mobile start",
    "contracts:generate": "pnpm --filter @accountbook/contracts generate",
    "contracts:check": "pnpm --filter @accountbook/contracts check:generated",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:unit": "pnpm --filter @accountbook/domain test && pnpm --filter @accountbook/web test && pnpm --filter @accountbook/mobile test && pnpm --filter @accountbook/api test",
    "test:integration": "cross-env DATABASE_URL=postgresql://accountbook:change-me@localhost:6432/accountbook pnpm --filter @accountbook/api test:integration",
    "test:e2e": "playwright test",
    "test:coverage": "pnpm --filter @accountbook/api test -- --coverage",
    "test": "pnpm test:unit"
  },
  "devDependencies": {
    "@playwright/test": "1.47.2",
    "cross-env": "7.0.3",
    "eslint": "9.35.0",
    "prettier": "3.6.2",
    "typescript": "5.6.3"
  }
}
